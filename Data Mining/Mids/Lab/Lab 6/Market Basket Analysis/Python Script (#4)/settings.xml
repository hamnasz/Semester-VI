        <entry key="script" type="xstring" value="import knime.scripting.io as knio%%00010import pandas as pd%%00010from itertools import combinations%%00010%%00010# 1. Read the binary matrix from Step 3%%00010df = knio.input_tables[0].to_pandas()%%00010if 'AccountID' in df.columns:%%00010    df = df.set_index('AccountID')%%00010%%00010# --- CONFIGURATION FOR STEP 5 ---%%00010min_support = 0.01  # Change this to 0.05 or 0.10 for Step 5%%00010min_confidence = 0.1%%00010# --------------------------------%%00010%%00010N = len(df)%%00010results = []%%00010%%00010# 2. Calculate Support for individual items%%00010item_support = df.mean()%%00010frequent_items = item_support[item_support &gt;= min_support].index.tolist()%%00010%%00010# 3. Calculate Support for Pairs (The &quot;Apriori&quot; part)%%00010for item_a, item_b in combinations(frequent_items, 2):%%00010    # Support(A &amp; B)%%00010    support_ab = (df[item_a] &amp; df[item_b]).mean()%%00010    %%00010    if support_ab &gt;= min_support:%%00010        support_a = item_support[item_a]%%00010        support_b = item_support[item_b]%%00010        %%00010        # Calculate Confidence: P(B|A) = Support(A&amp;B) / Support(A)%%00010        conf_a_to_b = support_ab / support_a%%00010        # Calculate Lift: Confidence / Support(B)%%00010        lift_a_to_b = conf_a_to_b / support_b%%00010        %%00010        if conf_a_to_b &gt;= min_confidence:%%00010            results.append({%%00010                'antecedents': item_a,%%00010                'consequents': item_b,%%00010                'support': support_ab,%%00010                'confidence': conf_a_to_b,%%00010                'lift': lift_a_to_b%%00010            })%%00010%%00010# 4. Create the output table%%00010rules_df = pd.DataFrame(results)%%00010%%00010# If no rules are found (common with high support), create an empty table with columns%%00010if rules_df.empty:%%00010    rules_df = pd.DataFrame(columns=['antecedents', 'consequents', 'support', 'confidence', 'lift'])%%00010%%00010knio.output_tables[0] = knio.Table.from_pandas(rules_df)"/>
